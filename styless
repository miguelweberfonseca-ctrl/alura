header {
            background-color: #000277;
            color: #FFFFFF;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
            padding: 16px;
            border: 5px solid #FAE700;
        }

        main {
            background-color: #FFFFFF;
            color: #000000;
            max-width: 800px;
            margin: 0 auto;
            padding: 16px;
        }
        img {
            width: 300px;
            height: 300px;

        }
        article {
            display: flex;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 30px;
            text-align: left;
        }

        article img {
            width: 300px;
            height: auto;
            flex-shrink: 0;
        }

        .artigo-autor {
            font-weight: bold;
        }

        button {
            cursor: pointer;
            padding: 5px 10px;
            margin-right: 5px;
        }
